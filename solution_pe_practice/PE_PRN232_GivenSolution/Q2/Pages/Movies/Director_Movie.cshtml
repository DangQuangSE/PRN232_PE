@page "/Movies/Director_Movie"
@model Q2.Pages.Movies.Director_MovieModel

<style>
    .movie-container {
        display: flex;
        align-items: flex-start;
        gap: 30px;
    }

    .director-list {
        width: 250px;
    }

    .director-item {
        margin-bottom: 10px;
    }

    table {
        border-collapse: collapse;
    }

    th, td {
        border: 1px solid black;
        padding: 5px;
    }
</style>

<div class="movie-container">

    <div class="director-list">
        <h2>Directors</h2>

        @foreach (var director in Model.Directors)
        {
            <div class="director-item">
                <a id="di_@director.Id"
                   href="/Movies/Director_Movie?directorId=@director.Id">
                    @director.FullName
                </a>
            </div>
        }
    </div>

    <div>
        <h2>List of Movies</h2>

        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Release Date</th>
                    <th>Description</th>
                    <th>Language</th>
                    <th>Director</th>
                    <th>Stars</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var movie in Model.Movies)
                {
                    <tr>
                        <td id="td_title_@movie.Id">
                            @movie.Title
                        </td>

                        <td id="td_releaseDate_@movie.Id">
                            @movie.ReleaseDate?.ToString("MM/dd/yyyy")
                        </td>

                        <td id="td_description_@movie.Id">
                            @movie.Description
                        </td>

                        <td id="td_language_@movie.Id">
                            @movie.Language
                        </td>

                        <td id="td_director_@movie.Id">
                            @movie.Director?.FullName
                        </td>

                        <td id="td_stars_@movie.Id">
                            @string.Join(",", movie.Stars.Select(
                            star => star.FullName))
                    </td>

                    <td id="td_action_@movie.Id">
                        <a id="btn_delete_@movie.Id" href="/Movies/Director_Movie?handler=Delete&id=@movie.Id">
                            Delete
                        </a>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>